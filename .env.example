# Copy to .env and adjust. Nothing here is safe as-is outside local development.

# Database (matches compose.yaml)
DB_URL=jdbc:postgresql://localhost:5433/nightgals
DB_USERNAME=nightgals
DB_PASSWORD=nightgals

# MUST be >= 32 characters. Rotating it invalidates every access token.
JWT_SECRET=change-me-in-production-this-is-a-dev-only-secret-key-0123456789

# Mixed into the document-number hash. Set once per environment and never change
# it: rotating breaks duplicate-account detection for existing submissions.
DOCUMENT_HASH_PEPPER=change-me-per-environment

# Creates the first admin on an empty database. Leave blank to skip.
BOOTSTRAP_ADMIN_EMAIL=admin@nightgals.local
BOOTSTRAP_ADMIN_PASSWORD=

# ── Email ────────────────────────────────────────────────────────────────────
# Sign-in codes go through here, so a broken mail config means NOBODY CAN LOG IN.
# If SMTP is down, set OTP_LOGIN_REQUIRED=false to fall back to password-only
# until it is fixed.
#
# Gmail needs an app password, not the account password, and an app password only
# works if 2-Step Verification is enabled on that same account. Google also
# revokes app passwords it finds published - which will happen to the one below,
# since it is committed to this repository. Getting `535 5.7.8 BadCredentials`
# means one of those three, not a bug in the app.
#
# Move to a transactional provider (SES, Postmark) before real volume - Gmail
# will throttle this and eventually treat it as suspicious.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=manaseschege0@gmail.com
MAIL_PASSWORD=rubp glig qtdn vzsy
MAIL_FROM=manaseschege0@gmail.com
MAIL_FROM_NAME=Nightgals
SUPPORT_EMAIL=manaseschege0@gmail.com
# false writes one-time codes to the log instead of sending them - handy on a
# machine with no outbound SMTP, never correct in production.
MAIL_ENABLED=true
# Used for links inside emails.
APP_BASE_URL=http://localhost:5173

# false drops back to password-only sign-in. Local development, or break-glass
# if the mail provider is down.
OTP_LOGIN_REQUIRED=true

# ── Google sign-in ─────────────────────────────────────────────────────
# A viewers-only door: signing in this way creates a VIEWER account, and a
# creator with a password is sent back to email + password. Leave blank to turn
# the whole feature off - the button stops rendering and the endpoint answers
# 503, rather than accepting tokens it has no audience to check them against.
#
# From the Google Cloud console: Credentials > OAuth client ID > *Web
# application*. Web application specifically - that is the audience baked into
# the token the browser's Google button produces.
#
# Add the site's origins under "Authorised JavaScript origins" (for example
# http://localhost:5173 and the production domain). The same value has to reach
# the site as VITE_GOOGLE_CLIENT_ID; a mismatch fails every sign-in.
GOOGLE_CLIENT_ID=

# ── Object storage ───────────────────────────────────────────────────────────
# s3 talks to MinIO locally and to AWS in production - same protocol either way.
# Set to `local` to write to the filesystem instead.
STORAGE_PROVIDER=s3
S3_BUCKET=nightgals-media
S3_REGION=us-east-1
# MinIO from compose.yaml. Leave BLANK on AWS so the SDK resolves the regional
# endpoint itself.
S3_ENDPOINT=http://localhost:9000
# Leave BLANK on AWS and use an instance or task role instead of static keys.
S3_ACCESS_KEY=nightgals
S3_SECRET_KEY=nightgals-secret
# Required by MinIO. Can stay true on AWS.
S3_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# Only read when STORAGE_PROVIDER=local
STORAGE_ROOT=./var/storage

# false makes publishing free and restores the flat 9-photo / 3-video allowance.
CREATOR_PACKAGES_ENABLED=true

# How long a new account gets everything for nothing. PT0S switches it off.
#
# Keep it off while testing payments: a trial account can already see every
# premium item, so buying one is refused as `already_unlocked` and there is
# nothing to pay for. To keep the trial but test as one person, expire only
# their account:
#   update users set trial_ends_at = now() - interval '1 day' where email = '...';
FREE_TRIAL=PT0S

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SERVER_PORT=8080

# ── Payment methods ──────────────────────────────────────────────────────────
# Every method on offer, in the order the checkout picker shows them. More than
# one runs at once and the buyer chooses per purchase.
#
#   momo    MTN Mobile Money - a prompt goes to the payer's handset
#   stripe  Cards, on a Stripe-hosted page
#   manual  stays PENDING until a human settles it
#   auto    completes instantly and COLLECTS NOTHING - pre-launch only
#
# Leave blank to fall back to the older single-valued PAYMENT_PROVIDER, and
# blank again to get `auto`.
PAYMENT_PROVIDERS=momo,stripe
# What a checkout that names no method gets. Blank means the first above.
DEFAULT_PAYMENT_PROVIDER=momo

# ── MTN Mobile Money ─────────────────────────────────────────────────────────
# From https://momodeveloper.mtn.com: subscribe to Collections, then mint an API
# user and key. Blank credentials with `momo` listed above fail at the first
# checkout, not at startup - so fill these in or drop momo from the list.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
# EUR is not a typo. Sandbox rejects everything else, including the XAF this
# product prices in. Move to XAF and target-environment together, not before.
MOMO_CURRENCY=EUR
# Must be public HTTPS, so blank on a laptop - reconciliation covers it.
MOMO_CALLBACK_URL=
# Scaffolding until viewers supply their own number at checkout. BLANK THIS
# BEFORE PRODUCTION or one person is billed for everyone else's purchases.
MOMO_SANDBOX_PAYER_MSISDN=

# ── Stripe (cards) ───────────────────────────────────────────────────────────
# Keys: https://dashboard.stripe.com/apikeys
#
# The publishable key is public by design and safe here. THE SECRET KEY IS THE
# ACCOUNT - anything holding it can move money - so it is blank in this file and
# must come from the environment or a secret store, never from a commit.
#
# sk_test_/pk_test_ and sk_live_/pk_live_ are separate worlds. Test cards
# decline against live keys, and a live webhook secret verifies nothing against
# test keys. Move all three together.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From the endpoint's page in the dashboard (Developers > Webhooks > your
# endpoint), NOT the API keys page. Different for every endpoint. Subscribe it
# to: checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed
#
# Blank means webhooks are refused and purchases settle by the reconciliation
# sweep instead - correct, just minutes slower. On a laptop that is the normal
# state, since Stripe needs a public HTTPS URL to reach; `stripe listen
# --forward-to localhost:8080/api/v1/webhooks/stripe` prints a whsec_ for local
# use.
STRIPE_WEBHOOK_SECRET=
# Where Stripe returns the payer. {purchaseId} is substituted. Deep links on
# mobile - nightgals://checkout/done?purchase={purchaseId}. Defaults are built
# from APP_BASE_URL, so both can be left blank for web.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# Stripe acting as merchant of record, calculating and remitting sales tax.
# Leave false. Accounts created recently have it enabled by default, and it
# requires every line item to carry a txcd_ tax code - with it on and no code,
# each checkout is rejected with "the product tax code is missing" instead of
# opening a page. Turning it on means classifying every PurchaseType first.
STRIPE_MANAGED_PAYMENTS=false

# ── Live streaming ───────────────────────────────────────────────────────────
# Where broadcasts go. This application serves no video either way; what changes
# is whether it PROVISIONS somewhere for one to happen.
#
#   manual   (default) the host supplies her own playbackUrl - the local Owncast
#            container, or her own OBS setup. No token, so the URL is the
#            credential and access cannot be revoked once handed out.
#   livekit  a room per broadcast over WebRTC, sub-second. Creators publish from
#            inside the app with no stream key, and every participant gets a
#            short-lived token minted after the entitlement check.
#
# Owncast is SINGLE-USER: one instance carries one broadcast. Two creators live
# at once would collide on the same stream key, so `manual` is a development
# arrangement. Anything multi-creator needs a provisioning provider.
LIVE_PROVIDER=manual

# From https://cloud.livekit.io - project settings, API keys. Only read when
# LIVE_PROVIDER=livekit; every bean is conditional on it, so leaving these blank
# costs nothing.
#
# The URL and key are public by design - the URL is handed to every viewer, and
# what protects a room is the token rather than the address. THE SECRET IS NOT:
# anything holding it can mint a publisher token for any room.
#
# LiveKit shows the secret ONCE, at creation, and it cannot be viewed again. If
# it is lost, generate a new pair rather than trying to recover it.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
