# Local development config. Gitignored - never commit this file.
# Generated from .env.example; see that file for what each setting does.

# Database (matches compose.yaml)
DB_URL=jdbc:postgresql://localhost:5433/nightgals
DB_USERNAME=nightgals
DB_PASSWORD=nightgals

# MUST be >= 32 characters. Rotating it invalidates every access token.
JWT_SECRET=change-me-in-production-this-is-a-dev-only-secret-key-0123456789

# Mixed into the document-number hash. Set once per environment and never change
# it: rotating breaks duplicate-account detection for existing submissions.
DOCUMENT_HASH_PEPPER=change-me-per-environment

# Creates the first admin on an empty database. Leave blank to skip.
BOOTSTRAP_ADMIN_EMAIL=admin@nightgals.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# ── Email ────────────────────────────────────────────────────────────────────
# Sign-in codes go through here, so a broken mail config means NOBODY CAN LOG IN.
# If SMTP is down, set OTP_LOGIN_REQUIRED=false to fall back to password-only
# until it is fixed.
#
# Gmail needs an app password, not the account password, and an app password only
# works if 2-Step Verification is enabled on that same account. Google also
# revokes app passwords it finds published - which will happen to the one below,
# since it is committed to this repository. Getting `535 5.7.8 BadCredentials`
# means one of those three, not a bug in the app.
#
# Move to a transactional provider (SES, Postmark) before real volume - Gmail
# will throttle this and eventually treat it as suspicious.

# The app password below is live and verified against smtp.gmail.com. Keep the
# spaces - Google prints it in groups of four and accepts it either way.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=manaseschege0@gmail.com
MAIL_PASSWORD=rubp glig qtdn vzsy
MAIL_FROM=manaseschege0@gmail.com
MAIL_FROM_NAME=Nightgals
SUPPORT_EMAIL=manaseschege0@gmail.com
# false writes one-time codes to the log instead of sending them - handy on a
# machine with no outbound SMTP, never correct in production.
MAIL_ENABLED=true
# Used for links inside emails.
APP_BASE_URL=http://localhost:5173

# false drops back to password-only sign-in. Local development, or break-glass
# if the mail provider is down.
OTP_LOGIN_REQUIRED=true

# ── Object storage ───────────────────────────────────────────────────────────
# s3 talks to MinIO locally and to AWS in production - same protocol either way.
# Set to `local` to write to the filesystem instead.
STORAGE_PROVIDER=s3
S3_BUCKET=nightgals-media
S3_REGION=us-east-1
# MinIO from compose.yaml. Leave BLANK on AWS so the SDK resolves the regional
# endpoint itself.
S3_ENDPOINT=http://localhost:9000
# Leave BLANK on AWS and use an instance or task role instead of static keys.
S3_ACCESS_KEY=nightgals
S3_SECRET_KEY=nightgals-secret
# Required by MinIO. Can stay true on AWS.
S3_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# Only read when STORAGE_PROVIDER=local
STORAGE_ROOT=./var/storage

# false makes publishing free and restores the flat 9-photo / 3-video allowance.
CREATOR_PACKAGES_ENABLED=true

# How long a new account gets everything for nothing. PT0S switches it off.
#
# Uncomment the second line to test the per-item paywall: a trial account can
# already see every premium item, so buying one is refused as `already_unlocked`
# and there is nothing to pay for. To keep the trial but test as one specific
# person, expire only their account instead:
#   update users set trial_ends_at = now() - interval '1 day' where email = '...';
# FREE_TRIAL=P7D
FREE_TRIAL=PT0S

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SERVER_PORT=8080

# Local override: codes go to the log until a working app password exists.
# Flip to true once MAIL_PASSWORD above is a live Gmail app password.

# ── Payment methods ──────────────────────────────────────────────────────────
# Both run at once; the buyer picks per checkout by sending `method`, and
# GET /api/v1/billing/payment-methods is what the picker renders from.
#
# Listing a provider without its credentials fails startup on purpose - a card
# button quietly missing in production is worse than a boot that says why. So
# the app will not start until STRIPE_SECRET_KEY below is filled in.
PAYMENT_PROVIDERS=momo,stripe
# What a checkout naming no method gets.
DEFAULT_PAYMENT_PROVIDER=momo

# ── MTN Mobile Money (sandbox) ───────────────────────────────────────────────
# Credentials come from https://momodeveloper.mtn.com - subscribe to
# Collections, then mint an API user and key. Sandbox moves no money and only
# accepts EUR.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=68f5d8d04b8946b7b1013c518dc91780
MOMO_API_USER=76faa6bf-6b7a-4981-89ae-cf631c868627
MOMO_API_KEY=c4531016edba475f943f79db5798eb51
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=EUR
MOMO_CALLBACK_URL=
MOMO_SANDBOX_PAYER_MSISDN=237689686224

# ── Stripe (cards) ───────────────────────────────────────────────────────────
# The publishable key is public by design - it identifies the account to a
# browser and is meant to be shipped in a client. This one is the LIVE key from
# the "Next Solutions Business" account.
STRIPE_PUBLISHABLE_KEY=pk_live_51U0nIHCCQhrATB1OpjjeZJzma7d0wXRtoZkC9PWcUv8LXqnI2muWoLOkpK0cSbYxjtmHo81KZJCmH1Qbjvio046Y00hfhs9DyK

#
# LEFT BLANK ON PURPOSE - paste your own. Reveal it at
# https://dashboard.stripe.com/apikeys and note that it pairs with the
# publishable key above: a live secret (sk_live_) with a test publishable key,
# or the reverse, fails in ways that do not name the cause.
#
# The application refuses to start with `stripe` in PAYMENT_PROVIDERS and this
# blank, rather than failing at the first checkout.
#
# Starting on sk_test_ is worth it: the whole flow runs, card 4242 4242 4242
# 4242 succeeds, 4000 0000 0000 0002 declines, and no real money moves.
STRIPE_SECRET_KEY=
#
# Blank locally. Stripe needs a public HTTPS URL to deliver to, so on a laptop
# purchases settle by the reconciliation sweep instead - correct, a couple of
# minutes slower. For webhooks locally:
#   stripe listen --forward-to localhost:8080/api/v1/webhooks/stripe
# which prints a whsec_ to paste here.
STRIPE_WEBHOOK_SECRET=
# Blank uses APP_BASE_URL. Set these to deep links for the mobile app.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
